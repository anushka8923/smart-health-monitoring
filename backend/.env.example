# ==============================================================================
# SMART HEALTH EWS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy these values into your root .env file and replace placeholders with real values.
# ==============================================================================

# Database Settings
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_health_db"

# ------------------------------------------------------------------------------
# 1. FAST2SMS API CREDENTIALS
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY="your_fast2sms_api_key"

# ------------------------------------------------------------------------------
# 2. META WHATSAPP BUSINESS CLOUD API CREDENTIALS
# ------------------------------------------------------------------------------
META_WHATSAPP_TOKEN="EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
META_WHATSAPP_PHONE_NUMBER_ID="109876543210987"
META_WHATSAPP_API_VERSION="v18.0"

# ------------------------------------------------------------------------------
# 3. GMAIL / CUSTOM SMTP EMAIL CREDENTIALS
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465 # Use 465 for SSL or 587 for STARTTLS
SMTP_SENDER_EMAIL="your-official-ews@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx" # Gmail 16-character App Password (NOT personal password)
